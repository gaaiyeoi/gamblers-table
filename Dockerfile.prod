# 生产镜像：多阶段构建
# Stage 1: 使用 Vite 构建静态产物
# 注意：vitest 嵌套依赖的 vite@8.2.2 要求 node ^20.19||>=22.12 且 peer 需 esbuild ^0.27||^0.28，
#       故使用 node:24 以保证 npm 能正确解析 peer 依赖（node:20 的 npm 10 严格校验会失败）
FROM node:24-alpine AS build

WORKDIR /app

# 先复制依赖清单，充分利用 Docker 层缓存
COPY package.json package-lock.json ./
RUN npm ci

# 复制其余源码并构建
COPY . .
RUN npm run build

# Stage 2: 使用 Nginx 托管静态产物
FROM nginx:1.27-alpine

# 复制构建产物
COPY --from=build /app/dist /usr/share/nginx/html

# 复制 SPA 路由回退配置（监听 8000 端口）
COPY nginx.conf /etc/nginx/conf.d/default.conf

EXPOSE 8000

CMD ["nginx", "-g", "daemon off;"]
